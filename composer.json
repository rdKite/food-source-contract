{
    "name": "rdkite/food-source-contract",
    "description": "The food-source contract of the Merlin/Lori ecosystem: spec, nutrient registry, fixture and (from 3.B) the conformance suite.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "opis/json-schema": "^2.4",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "FoodSourceContract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoodSourceContract\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": [
            "pint --test",
            "phpstan analyse --level 8 src tests bin mock"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "bin": [
        "bin/food-source-conformance"
    ]
}
